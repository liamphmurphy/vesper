# Copy to .env. `make dev` reads SECRETS_KEY from it; the API and runner read
# the rest from the environment (config in server/internal/config).
# The macOS app doesn't use this file.

# First boot only (ignored once a workspace exists):
# A signed-in browser acts as this user. Setup asks you to replace placeholders.
# Opt in to the Northwind Labs demo only with SEED=true (for development).
SEED=false
# Otherwise, an empty workspace is created with this user and an Assistant
# with all persona permissions enabled. Existing data is never overwritten.
LOCAL_USER_NAME=Local user
LOCAL_USER_EMAIL=me@localhost

# 32-byte key (base64) for encrypting stored secrets. Generate with:
#   openssl rand -base64 32
SECRETS_KEY=

# Without it, Settings → Secrets is read-only. Harness API keys, the GitHub
# PAT and staging credentials are stored there, encrypted with this key.
# Losing the key makes stored secrets unreadable; set them again.

# How agents reach the app (shown with agent tokens as the MCP URL).
PUBLIC_URL=http://localhost:8000

# Runner (docs/dev/plan.md §6.5). Managed runs need a harness key secret
# (harness:anthropic for Claude Code, harness:openai for Codex) in
# Settings → Connections & secrets. Those can hold plan logins instead of API
# keys: sign in from Settings. GitHub access comes from git:pat.
RUNNER_MAX_CONCURRENT=2
# Limits for each agent VM; 0 turns one off.
# RUNNER_MEMORY_MB=8192
# RUNNER_PIDS_LIMIT=4096
# Keep run checkouts in a folder on this machine so you can open them in your
# own editor (docs/guide.md, "Open a run's code"). An absolute path:
# RUNNER_HOST_WORKSPACES_DIR=/Users/you/vesper/workspaces
# Behind a TLS-inspecting proxy (Zscaler, Netskope), give agent VMs the
# company's root certificate, as an absolute path to a PEM file. On a Mac:
#   security find-certificate -a -c Zscaler -p /Library/Keychains/System.keychain > ~/zscaler-root.pem
# RUNNER_EXTRA_CA_FILE=/Users/you/zscaler-root.pem

# Continue a main agent in a fresh session, briefed from the ticket, its plan,
# git and the delegation report, when its sub agents finish and its context is
# at least this many tokens (Claude Code reports it; Codex runs never roll
# over). It is checked only when a main agent's delegations finish, so a run
# that never delegates doesn't roll over. Read by the API and the runner.
# 150000 was chosen from measured runs (LAZYAGENTS-203):
# compare get_run's context_tokens, efficiency and cost to tune it. 0 never
# rolls over (the default).
# ROLLOVER_CONTEXT_TOKENS=150000
# Give ticket runs a generated map of their repository at its base commit
# (layout, package docs, entry points, make targets and npm scripts) as a
# context file, cached per commit. Read by the runner; off by default.
# RUNNER_REPO_MAP=false

# Optional JSON object of exact model ids to USD token rates. Each entry needs
# input_per_million, cached_input_per_million, and output_per_million.
# RUNNER_MODEL_PRICES={}
