{
  "manifest_version": 3,
  "name": "Vesper",
  "description": "Share a Safari tab with a Vesper persona, ask about a page or a selection, and save pages to Vesper.",
  "version": "1.0",
  "icons": {
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "background": {
    "scripts": [
      "lib.js",
      "background.js"
    ],
    "persistent": false
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vesper",
    "default_icon": {
      "16": "images/toolbar-16.png",
      "19": "images/toolbar-19.png",
      "32": "images/toolbar-32.png",
      "38": "images/toolbar-38.png"
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
