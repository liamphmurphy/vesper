<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Vesper for Safari's handler. Safari requires a sandboxed extension. It may open connections (to
     the Vesper app's server on 127.0.0.1) and read only the folder the app writes its connection
     file to (SafariConnectionFile), nothing else in the person's home. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/Vesper Safari/</string>
	</array>
</dict>
</plist>
