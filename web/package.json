{
  "name": "vesper-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-design-worker.mjs",
    "start": "STATIC_DIR=dist node dist/design-worker/server.mjs",
    "lint": "eslint",
    "gen": "openapi-typescript ../api/openapi.yaml -o lib/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:stack": "bash e2e-stack/run.sh",
    "test:unit": "node --experimental-strip-types --test lib/*.test.mjs lib/native-shell/*.test.mjs",
    "gen:inter-metrics": "node --experimental-strip-types scripts/gen-inter-metrics.mjs",
    "gen:design-tokens": "node --experimental-strip-types scripts/gen-design-tokens.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tanstack/react-query": "^5.105.1",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/markdown": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "docx": "^9.15.3",
    "elkjs": "^0.12.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "^12.3.0",
    "micromark-extension-gfm": "^3.0.0",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "^5.7.284",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "openapi-typescript": "^7.13.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
